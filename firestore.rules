rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'carlos.agz94@gmail.com';
    }
    function isRestaurantOwner(restaurantId) {
      return isAuth() &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.userId == request.auth.uid;
    }
    function isCauseOwner(causeId) {
      return isAuth() &&
        get(/databases/$(database)/documents/causes/$(causeId)).data.userId == request.auth.uid;
    }

    // ── restaurants ───────────────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      // Public read (needed for order page /r/[slug])
      allow read: if true;
      // Only the restaurant owner can write
      allow write: if isOwner(resource.data.userId)
                   || isOwner(restaurantId);

      // menu subcollection
      match /menu/{itemId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId);
      }

      // creditTransactions: owner reads, owner creates (log-only, no edits)
      match /creditTransactions/{txId} {
        allow read:   if isOwner(restaurantId);
        allow create: if isOwner(restaurantId);
        // No updates or deletes — transaction history is immutable
      }
    }

    // ── causes ────────────────────────────────────────────────────────────────
    match /causes/{causeId} {
      allow read: if true;
      // Owner can do anything on their cause doc
      allow write: if isOwner(resource.data.userId) || isOwner(causeId);
      // Any auth user can increment helpersCount only (triggered on order creation)
      allow update: if isAuth()
                   && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['helpersCount']);

      // Updates/noticias de la causa — solo el dueño
      match /updates/{updateId} {
        allow read: if true;
        allow create: if isCauseOwner(causeId);
        allow update: if isCauseOwner(causeId);
        allow delete:  if isCauseOwner(causeId);
      }
    }

    // ── orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth();
      allow create: if isAuth();
      // Restaurant owner updates order status; any auth user can only update donationStatus
      allow update: if isRestaurantOwner(resource.data.restaurantId)
                    || (isAuth()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['donationStatus']));
      allow delete: if false;

      // Chat restaurante ↔ cliente
      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth();
      }
    }

    // ── donations ─────────────────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if isAuth();
      // Created atomically with orders (client batch)
      allow create: if isAuth();
      // Only restaurant owner can mark as paid; only cause owner can confirm
      allow update: if isRestaurantOwner(resource.data.restaurantId)
                    || isCauseOwner(resource.data.causeId);
      allow delete: if false;

      // Chat causa ↔ restaurante
      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth();
      }
    }

    // ── commissions ───────────────────────────────────────────────────────────
    match /commissions/{restaurantId} {
      allow read: if isOwner(restaurantId) || isAdmin();
      match /weeks/{weekId} {
        allow read:   if isOwner(restaurantId) || isAdmin();
        allow create: if isOwner(restaurantId);
        allow update: if isAdmin(); // Solo el admin puede confirmar comisiones
      }
    }

    // ── direct_donations ──────────────────────────────────────────────────────
    match /direct_donations/{donationId} {
      // Customer can read their own; cause owner can read donations to their cause
      allow read: if isAuth() && (
        request.auth.uid == resource.data.customerId ||
        isCauseOwner(resource.data.causeId)
      );
      // Any auth user can create (customer initiating a direct donation)
      allow create: if isAuth();
      // Only cause owner can confirm/update amount
      allow update: if isCauseOwner(resource.data.causeId);
      allow delete: if false;

      // Chat: customer ↔ cause
      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth();
      }
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}
